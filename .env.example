DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_POOL_SIZE=5
# Optional; resolved relative to apps/api when running the import script.
SQLITE_SOURCE_PATH=data/cue-arena.db
INTERNAL_API_KEY=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-another-long-random-secret
API_PORT=4001
BFF_PORT=4000
